@* Họ và tên: Đinh Ngọc Cường *@
@* Mã sinh viên: 23103100260 *@
@* Nội dung thực hiện: Giao diện lịch sử lưu trú (các phiếu đã trả phòng) *@
@model IEnumerable<QuanLyKhachSan_UNETI06_TI17A4HN.Models.PhieuDatPhong>
@using QuanLyKhachSan_UNETI06_TI17A4HN.Helpers
@{
    ViewData["Title"] = "Lịch sử lưu trú";
    var danhSach = Model.ToList();
}

<h2 class="mb-3">Lịch sử lưu trú</h2>

<partial name="_ThongBao" />

@if (!danhSach.Any())
{
    <div class="alert alert-info">Bạn chưa có lần lưu trú nào đã hoàn tất.</div>
}
else
{
    <p class="text-muted">
        Tổng cộng <strong>@danhSach.Count</strong> lần lưu trú,
        tổng chi phí <strong>@DinhDang.Tien(danhSach.Sum(p => p.TongTienDuKien))</strong>.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ngày nhận</th>
                    <th>Ngày trả</th>
                    <th>Số đêm</th>
                    <th>Phòng</th>
                    <th>Loại phòng</th>
                    <th class="text-end">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in danhSach)
                {
                    <tr>
                        <td>@DinhDang.Ngay(p.NgayNhanDuKien)</td>
                        <td>@DinhDang.Ngay(p.NgayTraDuKien)</td>
                        <td>@((p.NgayTraDuKien.Date - p.NgayNhanDuKien.Date).Days)</td>
                        <td>@string.Join(", ", p.ChiTietDatPhongs.Select(c => c.Phong?.SoPhong))</td>
                        <td>@string.Join(", ", p.ChiTietDatPhongs.Select(c => c.Phong?.LoaiPhong?.TenLoaiPhong).Distinct())</td>
                        <td class="text-end">@DinhDang.Tien(p.TongTienDuKien)</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.MaPhieuDat"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}