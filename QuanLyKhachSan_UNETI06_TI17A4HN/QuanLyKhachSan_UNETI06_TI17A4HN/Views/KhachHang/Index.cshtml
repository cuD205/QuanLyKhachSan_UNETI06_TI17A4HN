@* Họ và tên: Đinh Ngọc Cường *@
@* Mã sinh viên: 23103100260 *@
@* Nội dung thực hiện: Giao diện danh sách và tìm kiếm khách hàng (Admin) *@
@model IEnumerable<QuanLyKhachSan_UNETI06_TI17A4HN.Models.KhachHang>
@using QuanLyKhachSan_UNETI06_TI17A4HN.Helpers
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var tuKhoa = ViewData["TuKhoa"] as string;
    var danhSach = Model.ToList();
}

<h1 class="mb-1">Quản lý khách hàng</h1>
<p class="text-muted mb-4">Tìm kiếm, xem chi tiết và khóa/mở khóa khách hàng.</p>

<partial name="_ThongBao" />

<div class="card mb-4">
    <div class="card-header">Tìm khách hàng</div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label" for="tuKhoa">Họ tên, số điện thoại, email hoặc CCCD</label>
                    <input type="text" id="tuKhoa" name="tuKhoa" value="@tuKhoa" class="form-control"
                           placeholder="Ví dụ: Nguyen hoặc 0912345678" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-primary">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Kết quả</span>
        <small class="text-muted">Hiển thị @danhSach.Count khách hàng</small>
    </div>

    @if (!danhSach.Any())
    {
        <div class="card-body">
            <p class="text-muted mb-0">Không tìm thấy khách hàng nào phù hợp.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Họ tên</th>
                        <th>Ngày sinh</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>CCCD</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in danhSach)
                    {
                        <tr>
                            <td class="fw-semibold">@item.HoTen</td>
                            <td>@DinhDang.Ngay(item.NgaySinh)</td>
                            <td>@item.SoDienThoai</td>
                            <td>@item.Email</td>
                            <td>@item.CCCD</td>
                            <td>
                                <span class="@DinhDang.ClassTrangThaiKhach(item.TrangThai)">
                                    @DinhDang.TenTrangThaiKhach(item.TrangThai)
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaKhachHang">Chi tiết</a>
                                <form asp-action="DoiTrangThai" asp-route-id="@item.MaKhachHang" method="post"
                                      class="d-inline ms-2"
                                      onsubmit="return confirm('Bạn có chắc muốn @(item.TrangThai ? "khóa" : "mở khóa") khách hàng này?');">
                                    <button type="submit"
                                            class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-primary")">
                                        @(item.TrangThai ? "Khóa" : "Mở khóa")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>