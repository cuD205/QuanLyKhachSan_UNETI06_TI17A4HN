@* Họ và tên: Đinh Ngọc Cường *@
@* Mã sinh viên: 23103100260 *@
@* Nội dung thực hiện: Giao diện danh sách và tìm kiếm khách hàng (Admin) *@
@model IEnumerable<QuanLyKhachSan_UNETI06_TI17A4HN.Models.KhachHang>
@using QuanLyKhachSan_UNETI06_TI17A4HN.Helpers
@{
    ViewData["Title"] = "Quản lý khách hàng";
    var tuKhoa = ViewData["TuKhoa"] as string;
}

<h2 class="mb-3">Quản lý khách hàng</h2>

<partial name="ThongBao" />

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control"
               placeholder="Tìm theo họ tên, số điện thoại, email, CCCD..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa tìm kiếm</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Không tìm thấy khách hàng nào phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>CCCD</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.HoTen</td>
                        <td>@DinhDang.Ngay(item.NgaySinh)</td>
                        <td>@item.SoDienThoai</td>
                        <td>@item.Email</td>
                        <td>@item.CCCD</td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Bị khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.MaKhachHang"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                            <form asp-action="DoiTrangThai" asp-route-id="@item.MaKhachHang" method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn @(item.TrangThai ? "khóa" : "mở khóa") khách hàng này?');">
                                <button type="submit"
                                        class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success")">
                                    @(item.TrangThai ? "Khóa" : "Mở khóa")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}