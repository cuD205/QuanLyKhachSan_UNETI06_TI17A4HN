@* Họ và tên: Đinh Ngọc Cường *@
@* Mã sinh viên: 23103100260 *@
@* Nội dung thực hiện: Giao diện khách hàng xem/sửa thông tin cá nhân *@
@model QuanLyKhachSan_UNETI06_TI17A4HN.ViewModels.ThongTinCaNhanViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    bool daCoHoSo = ViewData["DaCoHoSo"] as bool? ?? false;
    bool biKhoa = ViewData["BiKhoa"] as bool? ?? false;
}

<h1 class="mb-1">Thông tin cá nhân</h1>
<p class="text-muted mb-4">Xem và cập nhật thông tin hồ sơ khách hàng của bạn.</p>

<partial name="_ThongBao" />

@if (!daCoHoSo)
{
    <div class="alert alert-warning">
        Bạn chưa có hồ sơ khách hàng. Vui lòng điền đầy đủ thông tin bên dưới để có thể đặt phòng.
    </div>
}

@if (biKhoa)
{
    <div class="alert alert-danger">
        Hồ sơ của bạn đang bị khóa, bạn chỉ có thể xem thông tin. Vui lòng liên hệ khách sạn.
    </div>
}

<div class="card">
    <div class="card-header">Hồ sơ khách hàng</div>
    <div class="card-body">
        <form asp-action="ThongTinCaNhan" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NgaySinh" class="form-label"></label>
                    <input asp-for="NgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="GioiTinh" class="form-label"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nu">Nữ</option>
                        <option value="Khac">Khác</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control" />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="CCCD" class="form-label"></label>
                    <input asp-for="CCCD" class="form-control" />
                    <span asp-validation-for="CCCD" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="DiaChi" class="form-label"></label>
                    <textarea asp-for="DiaChi" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@biKhoa">Lưu thông tin</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}