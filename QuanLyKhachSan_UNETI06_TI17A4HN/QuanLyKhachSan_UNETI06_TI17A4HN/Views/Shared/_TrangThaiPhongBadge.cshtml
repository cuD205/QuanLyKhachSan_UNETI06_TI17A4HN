@model string
@{
    var (cls, text) = Model switch
    {
        TrangThaiPhong.SanSang => ("badge-sansang", "Sẵn sàng"),
        TrangThaiPhong.DangSuDung => ("badge-dangsudung", "Đang sử dụng"),
        TrangThaiPhong.TamNgung => ("badge-tamngung", "Tạm ngừng"),
        _ => ("bg-secondary", Model)
    };
}
<span class="badge badge-trangthai @cls">@text</span>