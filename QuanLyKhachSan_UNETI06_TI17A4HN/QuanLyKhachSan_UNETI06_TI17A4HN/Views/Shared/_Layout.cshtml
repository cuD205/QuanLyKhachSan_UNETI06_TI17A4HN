    @*  Ho va ten: Duong Minh Duc | Ma sinh vien: 23103100282
    Noi dung thuc hien: Navbar va layout dung chung, ap dung theme site.css *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khach San UNETI06</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-main navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Khach San UNETI06
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        @* Moi link ung voi 1 Module - 4 ban tu bo sung Controller/Action dung ten minh dat *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Phong" asp-action="Index">Phong</a> @* Module 2 - Dien *@
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LoaiPhong" asp-action="Index">Loai phong</a> @* Module 1 - Liem *@
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DatPhong" asp-action="Index">Dat phong</a> @* Module 3 - Cuong *@
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PhieuDatPhong" asp-action="Index">Phieu dat phong</a> @* Module 4 - Duc *@
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ThongKe" asp-action="Dashboard">Dashboard</a> @* Module 4 - Duc *@
                        </li>
                        @if (Context.Session.GetString("VaiTro") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="KhachHang" asp-action="Index">Quản lý khách hàng</a>
                            </li>
                        }
                        @if (Context.Session.GetString("VaiTro") == "KhachHang")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="KhachHang" asp-action="ThongTinCaNhan">Thông tin cá nhân</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @* Hien thi theo Session - Liem code phan nay khi lam dang nhap/dang xuat *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">Dang nhap</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-top: 24px; margin-bottom: 48px;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="padding: 16px 0; text-align:center;">
        <div class="container">
            &copy; 2026 - Nhom 06 - De tai 05: Quan ly Khach san va Dat phong
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
