@{
}
@* Họ và tên: Diện | Module 2: Danh sách Phòng *@
@model QuanLyKhachSan_UNETI06_TI17A4HN.Models.PhongIndexViewModel
@{
    bool laAdmin = ViewBag.LaAdmin == true;
    ViewData["Title"] = "Danh sách phòng";
    var vi = new System.Globalization.CultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách phòng</h2>
    @if (laAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">Thêm phòng</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Số phòng</th>
                <th>Loại phòng</th>
                <th>Tầng</th>
                <th class="text-end">Đơn giá/đêm</th>
                <th>Trạng thái</th>
                
                <th>Thao tác</th>
                @if (laAdmin)
                {
                    <th>Đổi trạng thái</th>
                }

            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Phongs)
            {
                <tr>
                    <td>@p.SoPhong</td>
                    <td>@(p.LoaiPhong?.TenLoaiPhong ?? "(chưa có)")</td>
                    <td>@p.Tang</td>
                    <td class="text-end">@p.DonGiaDem.ToString("N0", vi) đ</td>
                    <td><partial name="_TrangThaiPhongBadge" model="p.TrangThai" /></td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.MaPhong">Chi tiết</a>
                        @if (laAdmin)
                        {
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@p.MaPhong">Sửa</a>
                        }
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.MaPhong">Xóa</a>
                    </td>
                    @if (laAdmin)
                    {
                        <td>
                            @if (p.TrangThai == TrangThaiPhong.DangSuDung)
                            {
                                <span class="text-muted">Đang có khách</span>
                            }
                            else
                            {
                                <form asp-action="CapNhatTrangThai" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@p.MaPhong" />
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <select name="trangThai" class="form-select form-select-sm">
                                        <option value="@TrangThaiPhong.SanSang" selected="@(p.TrangThai == TrangThaiPhong.SanSang)">Sẵn sàng</option>
                                        <option value="@TrangThaiPhong.TamNgung" selected="@(p.TrangThai == TrangThaiPhong.TamNgung)">Tạm ngừng</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">Cập nhật</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.Phongs.Any())
            {
                <tr><td colspan="@(laAdmin ? 7 : 6)" class="text-center text-muted">Chưa có phòng nào.</td></tr>
            }
        </tbody>
    </table>
</div>