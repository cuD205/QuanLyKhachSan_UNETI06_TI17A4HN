@* Module: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@* Nội dung: Form sửa loại phòng *@
@model LoaiPhong
@{
    ViewData["Title"] = "Sửa loại phòng";
}

<h1 class="h3 mb-3">Sửa loại phòng</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Thông tin loại phòng</div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.MaLoaiPhong" method="post">
                    <input type="hidden" asp-for="MaLoaiPhong" />
                    <partial name="_FormLoaiPhong" model="Model" />
                    <button type="submit" class="btn btn-primary">Cập nhật</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
