@* Module: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@* Nội dung: Các trường nhập liệu dùng chung cho form Thêm / Sửa loại phòng *@
@model LoaiPhong

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="mb-3">
    <label asp-for="TenLoaiPhong" class="form-label">Tên loại phòng</label>
    <input asp-for="TenLoaiPhong" class="form-control" maxlength="100" />
    <span asp-validation-for="TenLoaiPhong" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SoNguoiToiDa" class="form-label">Số người tối đa</label>
        <input asp-for="SoNguoiToiDa" class="form-control" type="number" min="1" />
        <span asp-validation-for="SoNguoiToiDa" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DonGiaDem" class="form-label">Đơn giá một đêm (₫)</label>
        <input asp-for="DonGiaDem" class="form-control" type="number" min="0" step="1000" />
        <span asp-validation-for="DonGiaDem" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="MoTa" class="form-label">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
    <span asp-validation-for="MoTa" class="text-danger"></span>
</div>

<div class="mb-3">
    <label class="form-label d-block">Trạng thái</label>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" asp-for="TrangThai" value="true" id="trangThaiBat" />
        <label class="form-check-label" for="trangThaiBat">Đang kinh doanh</label>
    </div>
    <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" asp-for="TrangThai" value="false" id="trangThaiTat" />
        <label class="form-check-label" for="trangThaiTat">Ngừng kinh doanh</label>
    </div>
    <span asp-validation-for="TrangThai" class="text-danger d-block"></span>
</div>
